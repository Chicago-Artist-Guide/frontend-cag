{
  "name": "frontend_cag",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "setup": "npm ci && npm --prefix infra ci",
    "dev": "next dev",
    "dev:container": "docker compose --env-file .env.local up --build app",
    "dev:container:start": "npm ci --prefer-offline && npm run dev -- --hostname 0.0.0.0",
    "start": "next start",
    "build": "next build",
    "build:legacy": "tsc && vite build",
    "start:legacy": "vite",
    "preview:legacy": "vite preview",
    "smoke:server": "node scripts/smoke-server.mjs",
    "container:smoke": "node --env-file-if-exists=.env.local scripts/smoke-container.mjs",
    "infra:verify": "npm --prefix infra run verify",
    "test": "vitest run",
    "test:e2e": "CAG_PLAYWRIGHT_SERVER_MODE=managed playwright test",
    "test:e2e:external": "CAG_PLAYWRIGHT_SERVER_MODE=external playwright test",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project cag-rules-tests \"vitest run --config vitest.rules.config.ts\"",
    "lint": "eslint --fix --max-warnings=250",
    "lint:check": "eslint app scripts/*.mjs scripts/*.test.ts src --max-warnings=406",
    "audit": "better-npm-audit audit",
    "vr:unit": "vitest run scripts/visual-regression/*.test.ts",
    "vr:lint": "eslint scripts/visual-regression --max-warnings=0",
    "vr:typecheck": "tsc -p scripts/visual-regression/tsconfig.json --noEmit",
    "vr:auth": "tsx scripts/visual-regression/auth-setup.ts",
    "vr:baseline": "tsx scripts/visual-regression/capture.ts baseline",
    "vr:calibrate": "tsx scripts/visual-regression/calibrate.ts",
    "vr:capture": "tsx scripts/visual-regression/capture.ts capture",
    "vr:diff": "tsx scripts/visual-regression/diff.ts",
    "vr:report": "tsx scripts/visual-regression/report.ts",
    "vr:verify": "tsx scripts/visual-regression/verify.ts",
    "migrate:codemod": "tsx scripts/migrate-styles/codemod.ts",
    "migrate:cycle": "tsx --env-file=.env.local scripts/migrate-cycle.ts",
    "verify": "npm run lint:check && npm test && npm run build && npm run infra:verify"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.2.0",
    "@fortawesome/fontawesome-svg-core": "^6.2.0",
    "@fortawesome/free-regular-svg-icons": "^6.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.2.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "axios": "^1.8.2",
    "better-npm-audit": "^3.7.3",
    "bootstrap": "^4.6.2",
    "client-only": "0.0.1",
    "clsx": "^1.2.1",
    "date-fns": "^2.29.3",
    "firebase": "^10.9.0",
    "formik": "^2.4.6",
    "multiselect-react-dropdown": "^2.0.25",
    "next": "16.2.10",
    "query-string": "^8.1.0",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.5",
    "react-datepicker": "^7.5.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-easy-crop": "^5.4.2",
    "react-hooks-helper": "^1.6.0",
    "react-image-crop": "^10.1.5",
    "react-masonry-css": "^1.0.16",
    "react-router": "^6.26.1",
    "reactstrap": "^9.2.3",
    "recharts": "^3.1.2",
    "sass": "^1.66.1",
    "styled-bootstrap-grid": "^3.1.0",
    "styled-components": "^6.1.13",
    "sweetalert2": "^11.12.4",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.0.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.17.8",
    "@babel/eslint-parser": "^7.17.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@types/jest": "^27.5.2",
    "@types/js-cookie": "^2.2.6",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-hooks-helper": "^1.6.2",
    "@types/react-image-crop": "^8.1.3",
    "@types/react-router": "^4.0.26",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^5.17.0",
    "@typescript-eslint/parser": "^5.17.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.12.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "firebase-tools": "^13.35.1",
    "husky": "^1.3.1",
    "jsdom": "^25.0.1",
    "lint-staged": "^12.3.7",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.14",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "react-router-dom": "^6.26.1",
    "tailwindcss": "^3.4.10",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "vite-plugin-svgr": "^4.2.0",
    "vitest": "^3.2.4"
  },
  "eslintConfig": {
    "rules": {
      "jsx-a11y/anchor-is-valid": 0,
      "quotes": [
        2,
        "single",
        {
          "avoidEscape": true
        }
      ]
    },
    "plugins": [
      "@typescript-eslint",
      "react",
      "react-hooks"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/eslint-recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "sourceType": "module",
      "ecmaVersion": "latest"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,jsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=250"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
