# Public client configuration required at build time.
# Put real local values in .env.local; CI values belong in GitHub Environments.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_LGL_API_KEY=
# Absolute origin used by app/sitemap.ts and app/robots.ts. Defaults to
# https://www.chicagoartistguide.org when unset; override on preview/staging
# so generated URLs point at that environment instead of production.
NEXT_PUBLIC_SITE_URL=
# Zeffy donation form link used by the DONATE actions (header/footer, Donate
# page, FAQ). Defaults to the current end-of-year fundraiser in
# src/config/publicEnv.ts when unset; override per environment to swap the
# campaign without a code change.
NEXT_PUBLIC_ZEFFY_DONATION_URL=
