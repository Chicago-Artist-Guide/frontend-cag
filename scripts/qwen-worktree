#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: scripts/qwen-worktree '<task prompt>'" >&2
  exit 64
fi

workspace="$(git rev-parse --show-toplevel)"
git_dir="$(git rev-parse --git-dir)"
common_dir="$(git rev-parse --git-common-dir)"
common_abs="$(cd "$common_dir" && pwd -P)"
main_checkout="$(dirname "$common_abs")"
extension_path="$workspace/.pi/extensions/workspace-guard.ts"

if [[ "$git_dir" == "$common_dir" ]]; then
  echo "Refusing to run Qwen in the main checkout. Use an isolated git worktree." >&2
  exit 65
fi

if [[ ! -f "$extension_path" ]]; then
  echo "Missing workspace guard extension: $extension_path" >&2
  exit 66
fi

main_before="$(mktemp)"
main_after="$(mktemp)"
trap 'rm -f "$main_before" "$main_after"' EXIT

git -C "$main_checkout" status --porcelain=v1 --untracked-files=no > "$main_before"

system_prompt="You are editing ONLY this workspace: $workspace

Hard rules:
- Use relative paths from this workspace.
- Never call file tools with absolute paths.
- Never edit the parent checkout: $main_checkout
- If a tool blocks a path, retry with a relative path inside this workspace.
- Do not use bash for edits. Use read/edit/write only.
- Keep changes scoped to the user's task."

set +e
pi \
  --provider spark \
  --model coder \
  --thinking off \
  --offline \
  --no-extensions \
  --extension "$extension_path" \
  --no-context-files \
  --tools read,edit,write \
  --append-system-prompt "$system_prompt" \
  --print \
  "$@"
pi_status=$?
set -e

git -C "$main_checkout" status --porcelain=v1 --untracked-files=no > "$main_after"

if ! cmp -s "$main_before" "$main_after"; then
  echo "Qwen workspace guard detected tracked changes in the parent checkout:" >&2
  diff -u "$main_before" "$main_after" >&2 || true
  exit 97
fi

exit "$pi_status"
